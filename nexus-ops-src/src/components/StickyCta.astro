---
// nexus-ops-src/src/components/StickyCta.astro
---

<div class="sticky-cta" id="sticky-cta">
  <div class="sticky-urgency">🔥 Solo quedan <strong>2 cupos fundadores</strong> disponibles</div>
  <a href="#contacto"
     onclick="gtag('event','cta_click',{event_category:'sticky_mobile',event_label:'contacto'})">
    Quiero acceso anticipado →
  </a>
</div>

<script is:inline>
/* ── STICKY CTA: ocultar cuando se ve #contacto ── */
(function () {
  const stickyEl  = document.getElementById('sticky-cta');
  const contactEl = document.getElementById('contacto');
  if (!stickyEl || !contactEl) return;
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      stickyEl.classList.toggle('oculta', e.isIntersecting);
    });
  }, { threshold: 0.15 });
  obs.observe(contactEl);
})();
</script>

<style>
.sticky-cta {
  display: none; position: fixed; bottom: 0; left: 0; right: 0; z-index: 480;
  background: rgba(10,14,26,.97); border-top: 1px solid var(--border);
  padding: .6rem 1.25rem .85rem; backdrop-filter: blur(8px);
}
.sticky-urgency {
  text-align: center; font-size: .72rem; color: var(--text-muted);
  margin-bottom: .4rem; letter-spacing: .01em;
}
.sticky-urgency strong { color: #fcd34d; }
@media (prefers-color-scheme: light) {
  :root:not([data-theme="dark"]) .sticky-cta { background: rgba(244,246,252,.97); }
}
:root[data-theme="light"] .sticky-cta { background: rgba(244,246,252,.97); }
.sticky-cta a {
  display: block; text-align: center; background: var(--accent); color: var(--bg);
  font-weight: 700; font-size: .95rem; padding: .72rem;
  border-radius: 8px; text-decoration: none; transition: background .2s;
}
.sticky-cta a:hover { background: #4f5fd6; text-decoration: none; }
@media (max-width: 640px) { .sticky-cta { display: block; } }
.sticky-cta.oculta { display: none !important; }
</style>
