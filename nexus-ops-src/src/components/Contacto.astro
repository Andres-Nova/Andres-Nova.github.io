---
// nexus-ops-src/src/components/Contacto.astro
---
<section id="contacto">
  <div class="container">
    <div class="cta-inner">

      <!-- Columna izquierda: beneficios -->
      <div class="cta-benefits">
        <div class="tag">Lista de espera</div>
        <h2>¿Listo para automatizar tu negocio?</h2>
        <p class="cta-lead">Únete a la lista y sé de los primeros en acceder. Precio fundador garantizado.</p>
        <ul class="benefit-list">
          <li>
            <span class="bi">⚡</span>
            <span><strong>Operativo en 5 días</strong><br>Configuramos todo sin que muevas un dedo</span>
          </li>
          <li>
            <span class="bi">🔒</span>
            <span><strong>Sin permanencia</strong><br>Cancelas cuando quieras, sin penalizaciones</span>
          </li>
          <li>
            <span class="bi">🇨🇴</span>
            <span><strong>Hecho para Colombia</strong><br>PSE, Nequi, Servientrega — realidad local</span>
          </li>
          <li>
            <span class="bi">💬</span>
            <span><strong>Soporte real</strong><br>Un equipo que responde, no un chatbot genérico</span>
          </li>
        </ul>
      </div>

      <!-- Columna derecha: formulario -->
      <div class="cta-form-wrap">
        <!-- Progreso cupos fundadores -->
        <div class="cupos-bar-wrap">
          <div class="cupos-row">
            <span class="cupos-label">Cupos fundadores</span>
            <span class="cupos-count"><strong>8</strong> de 10 tomados</span>
          </div>
          <div class="cupos-track">
            <div class="cupos-fill" style="width: 80%"></div>
          </div>
          <p class="cupos-note">Solo 2 lugares al precio fundador · Sin tarjeta de crédito</p>
        </div>
        <form class="cta-form" id="waitlist-form">
          <label class="form-label" for="email-input">Tu correo electrónico</label>
          <input type="email" name="email" placeholder="tu@correo.com" id="email-input" required />
          <button type="submit" class="btn btn-primary" id="waitlist-btn">Quiero acceso anticipado →</button>
          <p class="cta-note" id="cta-note">🔒 Sin spam. Solo te escribimos cuando abramos acceso.</p>
        </form>
      </div>

    </div>
  </div>
</section>

<style>
#contacto {
  background:
    linear-gradient(135deg, rgba(109,131,247,.07) 0%, transparent 60%),
    var(--bg);
  border-top: 1px solid var(--border);
}

.cta-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
  max-width: 960px;
  margin: 0 auto;
}

@media (max-width: 720px) {
  .cta-inner { grid-template-columns: 1fr; gap: 2.5rem; }
}

/* Columna izquierda */
.cta-benefits h2 {
  font-size: clamp(1.6rem, 3vw, 2.2rem);
  font-weight: 800;
  letter-spacing: -.04em;
  margin-bottom: .75rem;
  line-height: 1.15;
}

.cta-lead {
  color: var(--text-muted);
  font-size: 1rem;
  margin-bottom: 2rem;
  line-height: 1.6;
}

.benefit-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
}

.benefit-list li {
  display: flex;
  gap: .85rem;
  align-items: flex-start;
  font-size: .9rem;
  color: var(--text-muted);
  line-height: 1.45;
}

.benefit-list li strong { color: var(--text); display: block; margin-bottom: .1rem; }

.bi {
  font-size: 1.2rem;
  flex-shrink: 0;
  margin-top: .05rem;
}

/* Columna derecha */
.cta-form-wrap {
  background: var(--bg2);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 2rem;
}

.form-label {
  display: block;
  font-size: .82rem;
  font-weight: 600;
  color: var(--text-muted);
  letter-spacing: .04em;
  margin-bottom: .5rem;
}

.cta-form {
  display: flex;
  flex-direction: column;
  gap: .75rem;
}

.cta-form input {
  padding: .85rem 1.2rem;
  border-radius: 8px;
  border: 1px solid var(--border);
  background: var(--bg3);
  color: var(--text);
  font-size: .95rem;
  font-family: 'Inter', sans-serif;
  transition: border-color .2s;
}

.cta-form input:focus { outline: none; border-color: var(--accent); }

.cta-form .btn-primary {
  width: 100%;
  text-align: center;
  padding: .9rem;
  font-size: .95rem;
}

.cta-note {
  font-size: .78rem;
  color: var(--text-muted);
  text-align: center;
  margin-top: .25rem;
}

/* ── BARRA CUPOS FUNDADORES ── */
.cupos-bar-wrap {
  margin-bottom: 1.5rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--border);
}
.cupos-row {
  display: flex; justify-content: space-between; align-items: baseline;
  margin-bottom: .5rem;
}
.cupos-label { font-size: .78rem; font-weight: 600; color: var(--text-muted); letter-spacing: .04em; text-transform: uppercase; }
.cupos-count { font-size: .85rem; color: var(--text); }
.cupos-count strong { color: #fcd34d; }
.cupos-track {
  height: 6px; background: rgba(255,255,255,.06); border-radius: 999px;
  overflow: hidden; margin-bottom: .5rem;
}
.cupos-fill {
  height: 100%; border-radius: 999px;
  background: linear-gradient(90deg, var(--accent) 0%, #fcd34d 100%);
  animation: fill-in .8s ease forwards;
}
@keyframes fill-in { from { width: 0 !important; } }
.cupos-note { font-size: .73rem; color: var(--text-muted); text-align: center; }
</style>

<script is:inline>
  // Waitlist — envío real a Formspree
  document.getElementById('waitlist-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    const email = document.getElementById('email-input').value;
    const btn   = document.getElementById('waitlist-btn');
    const note  = document.getElementById('cta-note');
    btn.disabled = true;
    btn.textContent = 'Enviando…';
    try {
      const resp = await fetch('https://formspree.io/f/xeaqlaje', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ email })
      });
      if (resp.ok) {
        gtag('event', 'generate_lead', { event_category: 'conversion', event_label: 'waitlist', value: 1 });
        this.innerHTML = '<p style="color:var(--accent2);font-weight:600;font-size:1.1rem">✓ ¡Registrado! Te avisamos pronto 🚀</p>';
      } else {
        throw new Error('Error del servidor');
      }
    } catch {
      btn.disabled = false;
      btn.textContent = 'Quiero acceso anticipado';
      note.textContent = '⚠ No se pudo registrar. Intenta de nuevo o escríbenos directamente.';
      note.style.color = 'var(--accent3)';
    }
  });
</script>
