---
// nexus-ops-src/src/components/Contacto.astro
---
<section id="contacto">
  <div class="container">
    <div class="cta-box">
      <div class="tag">Lista de espera</div>
      <h2>¿Listo para automatizar tu negocio?</h2>
      <p>Déjanos tu correo y te contactamos cuando abramos el acceso para los primeros clientes.</p>
      <form class="cta-form" id="waitlist-form">
        <input type="email" name="email" placeholder="tu@correo.com" id="email-input" required />
        <button type="submit" class="btn btn-primary" id="waitlist-btn">Quiero acceso anticipado</button>
      </form>
      <p class="cta-note" id="cta-note">Sin spam. Solo te escribimos cuando esté listo.</p>
    </div>
  </div>
</section>

<style>
#contacto {
  background: linear-gradient(135deg, rgba(109,131,247,.05), rgba(109,131,247,.02));
  border-top: 1px solid var(--border);
}
.cta-box { text-align: center; max-width: 700px; margin: 0 auto; }
.cta-box h2 { font-size: clamp(1.6rem, 3vw, 2.4rem); font-weight: 800; margin-bottom: 1rem; letter-spacing: -.5px; }
.cta-box p { color: var(--text-muted); margin-bottom: 2rem; font-size: 1.05rem; }
.cta-form { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-bottom: 1.5rem; }
.cta-form input {
  padding: .8rem 1.2rem; border-radius: 8px;
  border: 1px solid var(--border); background: var(--bg2);
  color: var(--text); font-size: .95rem; min-width: 280px;
  font-family: 'Inter', sans-serif;
}
.cta-form input:focus { outline: none; border-color: var(--accent); }
.cta-note { font-size: .8rem; color: var(--text-muted); }
</style>

<script is:inline>
  // Waitlist — envío real a Formspree
  document.getElementById('waitlist-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    const email = document.getElementById('email-input').value;
    const btn   = document.getElementById('waitlist-btn');
    const note  = document.getElementById('cta-note');
    btn.disabled = true;
    btn.textContent = 'Enviando…';
    try {
      const resp = await fetch('https://formspree.io/f/xeaqlaje', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ email })
      });
      if (resp.ok) {
        gtag('event', 'generate_lead', { event_category: 'conversion', event_label: 'waitlist', value: 1 });
        this.innerHTML = '<p style="color:var(--accent2);font-weight:600;font-size:1.1rem">✓ ¡Registrado! Te avisamos pronto 🚀</p>';
      } else {
        throw new Error('Error del servidor');
      }
    } catch {
      btn.disabled = false;
      btn.textContent = 'Quiero acceso anticipado';
      note.textContent = '⚠ No se pudo registrar. Intenta de nuevo o escríbenos directamente.';
      note.style.color = 'var(--accent3)';
    }
  });
</script>
