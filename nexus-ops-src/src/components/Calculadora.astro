---
// Calculadora.astro - ROI Calculator component
---

<section id="calculadora">
  <div class="container">
    <div class="tag">Demo interactivo</div>
    <h2 class="section-title">¿Cuánto te cuesta operar sin automatización?</h2>
    <p class="section-sub">
      Ajusta los controles según tu negocio y ve en tiempo real el valor que estás dejando sobre la mesa cada mes.
    </p>
    <div class="calc-wrapper">

      <!-- Inputs -->
      <div class="calc-inputs">
        <div class="calc-field">
          <label>⏱ Horas/día respondiendo WhatsApp</label>
          <div class="input-row">
            <input type="range" id="r-horas" min="1" max="10" value="3" step="1" />
            <span class="val-badge" id="v-horas">3 h/día</span>
          </div>
        </div>
        <div class="calc-field">
          <label>📦 Pedidos por mes</label>
          <div class="input-row">
            <input type="range" id="r-pedidos" min="10" max="500" value="50" step="10" />
            <span class="val-badge" id="v-pedidos">50 pedidos</span>
          </div>
        </div>
        <div class="calc-field">
          <label>💵 Ticket promedio (COP $)</label>
          <div class="input-row">
            <input type="range" id="r-ticket" min="10000" max="500000" value="80000" step="5000" />
            <span class="val-badge" id="v-ticket">$80.000</span>
          </div>
        </div>
      </div>

      <!-- Resultados -->
      <div class="calc-results">
        <div class="result-card">
          <div class="r-row">
            <span class="r-label">⏳ Horas recuperadas / mes</span>
            <span class="r-val" id="res-horas">—</span>
          </div>
          <div class="r-bar-wrap"><div class="r-bar" id="bar-horas" style="width:0%"></div></div>
        </div>
        <div class="result-card">
          <div class="r-row">
            <span class="r-label">💼 Valor del tiempo ahorrado</span>
            <span class="r-val" id="res-tiempo">—</span>
          </div>
          <div class="r-bar-wrap"><div class="r-bar" id="bar-tiempo" style="width:0%"></div></div>
        </div>
        <div class="result-card">
          <div class="r-row">
            <span class="r-label">📈 Ventas recuperables (24/7)</span>
            <span class="r-val" id="res-ventas">—</span>
          </div>
          <div class="r-bar-wrap"><div class="r-bar" id="bar-ventas" style="width:0%"></div></div>
        </div>
        <div class="result-card total">
          <div class="r-total-label">🚀 Potencial mensual total</div>
          <div class="r-total-val" id="res-total">—</div>
          <div class="r-total-sub">recuperables automatizando tu operación</div>
        </div>
        <div class="calc-cta">
          <a href="#contacto" class="btn btn-primary"
             onclick="gtag('event','roi_cta_click',{event_category:'calculator',event_label:'to_waitlist'})">
            Quiero recuperar ese dinero →
          </a>
          <p class="calc-disclaimer">Estimaciones orientativas basadas en promedios de MiPYMEs colombianas.</p>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
#calculadora { background: var(--bg2); }
.calc-wrapper {
  display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; align-items: start;
}
@media (max-width: 760px) { .calc-wrapper { grid-template-columns: 1fr; } }
.calc-inputs { display: flex; flex-direction: column; gap: 1.5rem; }
.calc-field label {
  display: block; font-size: .85rem; font-weight: 600;
  color: var(--text-muted); margin-bottom: .5rem; letter-spacing: .04em;
}
.calc-field .input-row { display: flex; align-items: center; gap: .75rem; }
.calc-field input[type="range"] {
  flex: 1; accent-color: var(--accent); height: 4px; cursor: pointer;
}
.calc-field .val-badge {
  min-width: 90px; text-align: right; font-weight: 700;
  color: var(--accent); font-size: .95rem;
}
.calc-results { display: flex; flex-direction: column; gap: .85rem; }
.result-card {
  background: var(--bg3); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 1rem 1.25rem;
}
.r-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: .5rem; }
.result-card .r-label { font-size: .85rem; color: var(--text-muted); }
.result-card .r-val { font-size: 1.2rem; font-weight: 800; color: var(--accent); }

/* Barras de progreso */
.r-bar-wrap { height: 4px; background: rgba(255,255,255,.06); border-radius: 999px; overflow: hidden; }
.r-bar { height: 100%; background: var(--accent-gradient); border-radius: 999px; transition: width .4s ease; }

/* Card total */
.result-card.total {
  border-color: rgba(109,131,247,.5);
  background: linear-gradient(135deg, rgba(109,131,247,.1), rgba(79,95,214,.06));
  text-align: center; padding: 1.5rem;
}
.r-total-label { font-size: .8rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--text-muted); margin-bottom: .4rem; }
.r-total-val { font-size: 2.4rem; font-weight: 900; color: var(--accent); letter-spacing: -.03em; line-height: 1; }
.r-total-sub { font-size: .78rem; color: var(--text-muted); margin-top: .3rem; }

.calc-cta { margin-top: 1.5rem; text-align: center; }
.calc-disclaimer { font-size: .75rem; color: var(--text-muted); margin-top: .75rem; }
</style>

<script is:inline>
(function () {
const fmtCOP = (n) => '$' + Math.round(n).toLocaleString('es-CO');
let roiTouched = false;

function calcularROI() {
  const horas   = parseInt(document.getElementById('r-horas').value);
  const pedidos = parseInt(document.getElementById('r-pedidos').value);
  const ticket  = parseInt(document.getElementById('r-ticket').value);

  if (!roiTouched) {
    roiTouched = true;
    gtag('event', 'roi_open', { event_category: 'calculator', event_label: 'first_interaction' });
  }

  document.getElementById('v-horas').textContent   = horas + ' h/día';
  document.getElementById('v-pedidos').textContent = pedidos + ' pedidos';
  document.getElementById('v-ticket').textContent  = fmtCOP(ticket);

  const horasRecuperadas = horas * 22 * 0.70;
  const costoTiempo      = horasRecuperadas * 8000;
  const pedidosPerdidos  = pedidos * 0.25;
  const ventasRecup      = pedidosPerdidos * ticket;
  const total            = costoTiempo + ventasRecup;

  document.getElementById('res-horas').textContent  = Math.round(horasRecuperadas) + ' h/mes';
  document.getElementById('res-tiempo').textContent = fmtCOP(costoTiempo) + '/mes';
  document.getElementById('res-ventas').textContent = fmtCOP(ventasRecup) + '/mes';
  document.getElementById('res-total').textContent  = fmtCOP(total) + '/mes';

  /* Barras de progreso relativas al total */
  const pct = (v) => Math.min(100, Math.round(v / total * 100));
  document.getElementById('bar-horas').style.width  = pct(costoTiempo / 2) + '%';
  document.getElementById('bar-tiempo').style.width = pct(costoTiempo) + '%';
  document.getElementById('bar-ventas').style.width = pct(ventasRecup) + '%';

  gtag('event', 'roi_calcular', {
    event_category: 'calculator',
    horas_dia: horas,
    pedidos_mes: pedidos,
    ticket_cop: ticket,
    total_mensual_cop: Math.round(total)
  });
}

/* No hay onclick="calcularROI()" en el markup, pero se expone en window por
   consistencia con el resto de funciones invocadas desde fuera de su script. */
window.calcularROI = calcularROI;

['r-horas', 'r-pedidos', 'r-ticket'].forEach(id => {
  document.getElementById(id).addEventListener('input', calcularROI);
});
calcularROI();
})();
</script>
