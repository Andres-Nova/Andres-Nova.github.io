---
// nexus-ops-src/src/components/Servicios.astro
// Sección Servicios — infraestructura comercial completa
// Estático, sin JS
// Incluye CSS base + REDESIGN VISUAL overrides (.svc-icon, display:none para .servicio-icon/.servicio-num)
---

<section id="servicios">
  <div class="container">
    <div class="tag">Qué ofrecemos</div>
    <h2 class="section-title">Infraestructura comercial completa</h2>
    <p class="section-sub">
      Cuatro componentes integrados que Nexus Ops configura, mantiene y opera por ti.
    </p>
    <div class="servicios-grid">

      <div class="servicio-card fade-up">
        <div class="svc-icon">
          <!-- Monitor / landing page -->
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>
          </svg>
        </div>
        <h3>Landing Page de Producto</h3>
        <p>Página optimizada para conversión, hospedada y configurada por Nexus Ops. Diseño profesional, carga rápida, adaptada a tu marca.</p>
        <div class="servicio-tags">
          <span class="stag">Hosting incluido</span>
          <span class="stag">SEO básico</span>
          <span class="stag">Diseño responsive</span>
        </div>
      </div>

      <div class="servicio-card fade-up">
        <div class="svc-icon">
          <!-- Tarjeta de crédito / pago -->
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20M6 15h4"/>
          </svg>
        </div>
        <h3>Pasarela de Pago Local</h3>
        <p>Integración con PSE, Nequi y tarjetas de crédito/débito. Conciliación automática y comprobantes digitales listos para el cliente.</p>
        <div class="servicio-tags">
          <span class="stag">PSE</span>
          <span class="stag">Nequi</span>
          <span class="stag">Tarjetas</span>
        </div>
      </div>

      <div class="servicio-card fade-up">
        <div class="svc-icon">
          <!-- Caja / logística -->
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16v-2"/>
            <path d="M3.3 7l8.7 5 8.7-5M12 22V12"/>
          </svg>
        </div>
        <h3>Logística Automatizada</h3>
        <p>Integración con Servientrega, Coordinadora y Envia. Generación de guías y trazabilidad en tiempo real sin intervención manual.</p>
        <div class="servicio-tags">
          <span class="stag">Servientrega</span>
          <span class="stag">Coordinadora</span>
          <span class="stag">Envia</span>
        </div>
      </div>

      <div class="servicio-card fade-up">
        <div class="svc-icon">
          <!-- Chat bot / IA -->
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            <path d="M8 10h.01M12 10h.01M16 10h.01"/>
          </svg>
        </div>
        <h3>Asistente IA para WhatsApp</h3>
        <p>Bot entrenado con la info de tu negocio. Atiende consultas frecuentes, califica clientes, procesa pedidos y hace seguimiento postventa 24/7.</p>
        <div class="servicio-tags">
          <span class="stag">24/7</span>
          <span class="stag">Sin intervención</span>
          <span class="stag">Personalizable</span>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* ── SERVICIOS — BASE ── */
  #servicios {
    background: var(--bg);
  }

  .servicios-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .servicio-card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem;
    transition: border-color 0.25s, transform 0.25s;
  }

  .servicio-card:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
  }

  .servicio-num {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .servicio-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .servicio-card h3 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
  }

  .servicio-card p {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .servicio-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }

  .stag {
    font-size: 0.72rem;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--text);
    font-weight: 500;
  }

  /* ── SVG ICON CARDS — REDESIGN VISUAL ── */
  .svc-icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 14px;
    margin-bottom: 1.4rem;
    background: var(--bg3);
    transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1),
                border-color 0.2s, background 0.2s;
  }

  .svc-icon svg {
    width: 26px;
    height: 26px;
    stroke: var(--accent2);
  }

  .servicio-card:hover .svc-icon {
    transform: translateY(-4px) scale(1.08);
    border-color: var(--accent);
    background: var(--bg);
  }

  /* ── OVERRIDES — ocultar elementos viejos ── */
  .servicio-icon {
    display: none;
  }

  .servicio-num {
    display: none;
  }
</style>
