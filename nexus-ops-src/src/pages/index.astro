---
// nexus-ops-src/src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import TrustBadgesProblema from '../components/TrustBadgesProblema.astro';
import Servicios from '../components/Servicios.astro';
import Proceso from '../components/Proceso.astro';
import Precios from '../components/Precios.astro';
import Faq from '../components/Faq.astro';
import SegmentoPorque from '../components/SegmentoPorque.astro';
import Calculadora from '../components/Calculadora.astro';
import BlogPreviewLanding from '../components/BlogPreviewLanding.astro';
import Opiniones from '../components/Opiniones.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import WhatsappFlotante from '../components/WhatsappFlotante.astro';
import StickyCta from '../components/StickyCta.astro';
import EngagementLanding from '../components/EngagementLanding.astro';
---
<BaseLayout
  title="Nexus Ops — Automatización Comercial con IA para Emprendedores"
  description="Nexus Ops automatiza tu operación comercial con IA: landing page, pagos PSE/Nequi, logística Servientrega y asistente WhatsApp. Para emprendedores y MiPYMEs colombianas."
  keywords="automatización comercial, IA para negocios, WhatsApp bot, pasarela de pago Colombia, emprendedores colombianos, MiPYMEs, Nexus Ops"
  ogTitle="Nexus Ops — Automatización Comercial con IA"
  ogDescription="Infraestructura comercial completa para emprendedores colombianos: landing, pagos, logística y asistente IA para WhatsApp."
  gaTitle="Nexus Ops Landing"
  canonical="https://andres-nova.github.io/nexus-ops/"
>
  <Nav />
  <Hero />
  <TrustBadgesProblema />
  <Servicios />
  <Proceso />
  <Precios />
  <Faq />
  <SegmentoPorque />
  <Calculadora />
  <BlogPreviewLanding />
  <Opiniones />
  <Contacto />
  <Footer />
  <WhatsappFlotante />
  <StickyCta />
  <EngagementLanding />
