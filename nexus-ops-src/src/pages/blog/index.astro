---
// nexus-ops-src/src/pages/blog/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function fechaLegible(d: Date) {
  const s = d.toLocaleDateString('es-CO', { month: 'long', year: 'numeric', timeZone: 'UTC' });
  return s.charAt(0).toUpperCase() + s.slice(1);
}
---
<BaseLayout
  title="Blog Nexus Ops"
  description="Artículos sobre automatización con IA para emprendedores colombianos: WhatsApp bots, pagos automáticos, logística y más."
  ogDescription="Artículos prácticos de automatización e IA comercial para MiPYMEs en Colombia."
  canonical="https://andres-nova.github.io/nexus-ops/blog/"
>
  <nav>
    <a href="/nexus-ops/" class="nav-brand" onclick="gtag('event','nav_click',{event_category:'nav',event_label:'brand_landing'})">Nexus<span>Ops</span></a>
    <a href="/nexus-ops/" class="nav-back" onclick="gtag('event','nav_click',{event_category:'nav',event_label:'back_landing'})">← Nexus Ops</a>
  </nav>

  <main class="blog-container">
    <div class="blog-header">
      <h1>Blog Nexus Ops</h1>
      <p>Artículos sobre automatización con IA para emprendedores en Colombia.</p>
    </div>

    <div class="post-grid">
      {posts.map((post) => (
        <a
          href={`/nexus-ops/blog/${post.slug}/`}
          class="post-card"
          onclick={`gtag('event','post_click',{event_category:'blog_index',event_label:'${post.slug}'})`}
        >
          <div class="post-card-meta">
            <span class="post-card-badge">{post.data.badge}</span>
            <span>{fechaLegible(post.data.pubDate)}</span>
            <span>· {post.data.readingTime}</span>
          </div>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
          <div class="post-card-footer">Leer artículo →</div>
        </a>
      ))}
    </div>
  </main>

  <footer>
    <p>© 2026 Nexus Ops ·
      <a href="/nexus-ops/" onclick="gtag('event','footer_click',{event_category:'footer',event_label:'landing'})">Landing</a> ·
      <a href="https://andres-nova.github.io" onclick="gtag('event','footer_click',{event_category:'footer',event_label:'portafolio'})">Portafolio de Andres Nova</a>
    </p>
  </footer>

  <style>
    .blog-container { max-width: 860px; margin: 0 auto; padding: 3rem 1.5rem 5rem; }
    .blog-header { margin-bottom: 2.5rem; }
    .blog-header h1 { font-size: 1.8rem; font-weight: 800; letter-spacing: -.03em; margin-bottom: .5rem; }
    .blog-header p { color: var(--text-muted); }
    .post-grid { display: grid; gap: 1.5rem; }
    .post-card { background: var(--bg2); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; text-decoration: none; display: block; transition: border-color .2s, transform .25s cubic-bezier(.34,1.56,.64,1), box-shadow .25s; }
    .post-card:hover { border-color: var(--accent); transform: translateY(-4px); box-shadow: var(--shadow); text-decoration: none; }
    .post-card-meta { display: flex; gap: .8rem; flex-wrap: wrap; font-size: .78rem; color: var(--text-muted); margin-bottom: .8rem; align-items: center; }
    .post-card-badge { background: var(--bg3); border: 1px solid var(--border); border-radius: 4px; padding: .15rem .5rem; font-weight: 600; color: var(--accent); font-size: .75rem; }
    .post-card h2 { font-size: 1.1rem; font-weight: 700; color: var(--text); margin-bottom: .5rem; line-height: 1.3; }
    .post-card p { font-size: .88rem; color: var(--text-muted); margin: 0; }
    .post-card-footer { margin-top: 1rem; font-size: .82rem; color: var(--accent); font-weight: 600; }
    footer { border-top: 1px solid var(--border); padding: 2rem 1.5rem; text-align: center; font-size: .82rem; color: var(--text-muted); }
    footer a { color: var(--text-muted); }
    footer a:hover { color: var(--text); }
    /* nav/.nav-brand/.nav-back NO se redefinen acá — ya son globales en BaseLayout (Task 2) */
  </style>
</BaseLayout>
