---
// nexus-ops-src/src/layouts/BlogLayout.astro
import BaseLayout from './BaseLayout.astro';
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  badge: string;
  readingTime: string;
  canonical: string;
  keywords?: string;
}
const { title, description, pubDate, badge, readingTime, canonical, keywords } = Astro.props;
const fechaLegible = capitalizar(
  // es-CO produce "septiembre de 2026"; el original mostraba "Septiembre 2026"
  pubDate.toLocaleDateString('es-CO', { month: 'long', year: 'numeric', timeZone: 'UTC' }).replace(' de ', ' ')
);
function capitalizar(s: string) {
  return s.charAt(0).toUpperCase() + s.slice(1);
}
---
<BaseLayout title={title} description={description} canonical={canonical} ogType="article" keywords={keywords}>
  <Fragment slot="head-extra">
    <meta property="article:published_time" content={pubDate.toISOString().slice(0, 10)} />
    <meta property="article:author" content="Andres Nova" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": title,
      "description": description,
      "author": { "@type": "Person", "name": "Andres Nova" },
      "datePublished": pubDate.toISOString().slice(0, 10),
      "publisher": { "@type": "Organization", "name": "Nexus Ops" },
      "url": canonical
    })} />
  </Fragment>

  <style is:global>
    /* ── ARTICLE LAYOUT ── */
    .post-container { max-width: 720px; margin: 0 auto; padding: 3rem 1.5rem 5rem; }

    /* ── META ── */
    .post-meta { display: flex; flex-wrap: wrap; gap: .5rem 1.2rem; font-size: .82rem; color: var(--text-muted); margin-bottom: 2rem; align-items: center; }
    .post-badge { background: var(--bg3); border: 1px solid var(--border); border-radius: 4px; padding: .2rem .6rem; font-size: .78rem; color: var(--accent); font-weight: 600; letter-spacing: .04em; }

    /* ── HEADINGS ── */
    h1 { font-size: clamp(1.6rem, 4vw, 2.2rem); font-weight: 800; line-height: 1.2; color: var(--text); margin-bottom: 1rem; letter-spacing: -.03em; }
    h2 { font-size: 1.3rem; font-weight: 700; color: var(--accent); margin: 2.5rem 0 .8rem; border-bottom: 1px solid var(--border); padding-bottom: .4rem; }
    h3 { font-size: 1.05rem; font-weight: 600; color: var(--accent2); margin: 1.8rem 0 .5rem; }

    /* ── BODY TEXT ── */
    p { margin-bottom: 1.1rem; color: var(--text-muted); }
    p strong { color: var(--text); }
    ul, ol { margin: .8rem 0 1.2rem 1.4rem; color: var(--text-muted); }
    li { margin-bottom: .4rem; }
    li strong { color: var(--text); }

    /* ── QUOTE ── */
    blockquote { border-left: 3px solid var(--accent); padding: .8rem 1.2rem; margin: 1.5rem 0; background: var(--bg2); border-radius: 0 8px 8px 0; text-align: center; }
    blockquote p { color: var(--text); font-style: italic; margin: 0; }

    /* ── DIAGRAM ── */
    .diagram-wrap { background: var(--bg2); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; margin: 2rem 0; overflow-x: auto; }
    .diagram-wrap figcaption { font-size: .8rem; color: var(--text-muted); text-align: center; margin-top: .8rem; }

    /* ── CTA BOX ── */
    .cta-box { background: var(--bg2); border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent); border-radius: 12px; padding: 2rem; margin: 3rem 0; text-align: center; }
    .cta-box p { color: var(--text-muted); margin-bottom: 1.2rem; }

    /* ── REFERENCES ── */
    .references { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
    .references h2 { font-size: 1rem; margin-bottom: .8rem; }
    .references ol { font-size: .82rem; color: var(--text-muted); }
    .references li { margin-bottom: .35rem; }
    .references em { font-style: italic; }

    /* ── RELATED POSTS ── */
    .related-section { margin: 3rem 0; }
    .related-section h2 { font-size: 1.1rem; }
    .related-grid { display: grid; gap: 1rem; }
    .related-card { background: var(--bg2); border: 1px solid var(--border); border-radius: 10px; padding: 1rem 1.2rem; text-decoration: none; transition: border-color .2s; display: block; }
    .related-card:hover { border-color: var(--accent); text-decoration: none; }
    .related-card h4 { font-size: .9rem; font-weight: 600; color: var(--text); margin-bottom: .3rem; }
    .related-card p { font-size: .8rem; color: var(--text-muted); margin: 0; }

    /* ── GISCUS ── */
    .comments-section { margin-top: 4rem; }
    .comments-section h2 { font-size: 1.1rem; border-bottom: 1px solid var(--border); padding-bottom: .5rem; margin-bottom: 1rem; }
    .giscus-info { background: var(--bg2); border: 1px solid var(--border); border-radius: 10px; padding: 1rem 1.2rem; margin-bottom: 1.5rem; font-size: .85rem; color: var(--text-muted); }

    /* ── FOOTER ── */
    footer { border-top: 1px solid var(--border); padding: 2rem 1.5rem; text-align: center; font-size: .82rem; color: var(--text-muted); }
    footer a { color: var(--text-muted); }
    footer a:hover { color: var(--text); }

    @media (max-width: 640px) { .post-container { padding: 2rem 1rem 4rem; } }

    /* ── PEERS GRID ── */
    .peers-intro { font-size: .88rem; color: var(--text-muted); margin-bottom: 1.2rem; display: flex; align-items: center; gap: .5rem; }
    .peers-intro svg { flex-shrink: 0; opacity: .65; }
    .peers-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; margin: .5rem 0 1.5rem; }
    .peer-card {
      background: var(--bg2); border: 1px solid var(--border);
      border-radius: 12px; padding: 1.1rem 1.25rem 1rem;
      text-decoration: none; display: flex; flex-direction: column; gap: .5rem;
      transition: border-color .2s, transform .25s cubic-bezier(.34,1.56,.64,1), box-shadow .2s;
    }
    .peer-card:hover { border-color: var(--accent); transform: translateY(-3px); box-shadow: 0 10px 30px rgba(0,0,0,.22); text-decoration: none; }
    .peer-card-top { display: flex; align-items: center; gap: .75rem; }
    .peer-icon {
      width: 40px; height: 40px; border-radius: 10px;
      background: var(--bg3); border: 1px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.25rem; flex-shrink: 0;
      transition: transform .25s cubic-bezier(.34,1.56,.64,1);
    }
    .peer-card:hover .peer-icon { transform: scale(1.12) rotate(-4deg); }
    .peer-name { font-size: .88rem; font-weight: 700; color: var(--text); line-height: 1.3; }
    .peer-topic { font-size: .78rem; color: var(--text-muted); line-height: 1.45; flex: 1; }
    .peer-cta {
      margin-top: .35rem; font-size: .78rem; font-weight: 600;
      color: var(--accent); display: flex; align-items: center; gap: .35rem;
    }
    .peer-cta svg { width: 13px; height: 13px; stroke: var(--accent); }

    /* ── TRANSICIONES (elementos propios del post; nav/theme-toggle/canvas ya son globales) ── */
    .diagram-wrap, .cta-box, .related-card, .giscus-info, blockquote {
      transition: background-color .3s ease, border-color .3s ease, color .3s ease;
    }
  </style>

  <nav>
    <a href="/nexus-ops/" class="nav-brand" onclick="gtag('event','nav_click',{event_category:'nav',event_label:'brand_landing'})">Nexus<span>Ops</span></a>
    <a href="/nexus-ops/blog/" class="nav-back" onclick="gtag('event','nav_click',{event_category:'nav',event_label:'back_blog'})">← Blog</a>
  </nav>

  <main class="post-container">
    <div class="post-meta">
      <span class="post-badge">{badge}</span>
      <span>Andres Nova</span>
      <span>·</span>
      <span>{fechaLegible}</span>
      <span>·</span>
      <span>{readingTime}</span>
    </div>
    <h1>{title}</h1>
    <slot />

    <div class="comments-section">
      <h2>💬 Comentarios</h2>
      <div class="giscus-info">
        Necesitas una cuenta de <strong>GitHub gratuita</strong> para comentar.
        Los comentarios se sincronizan con las Discussions del repositorio.
      </div>
      <script src="https://giscus.app/client.js"
        data-repo="Andres-Nova/Andres-Nova.github.io"
        data-repo-id="R_kgDOTLKhzA"
        data-category="General"
        data-category-id="DIC_kwDOTLKhzM4DE-ZG"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="preferred_color_scheme"
        data-lang="es"
        crossorigin="anonymous"
        async>
      </script>
    </div>
  </main>

  <footer>
    <p>© 2026 Nexus Ops ·
      <a href="/nexus-ops/" onclick="gtag('event','footer_click',{event_category:'footer',event_label:'landing'})">Landing</a> ·
      <a href="/nexus-ops/blog/" onclick="gtag('event','footer_click',{event_category:'footer',event_label:'blog'})">Blog</a> ·
      <a href="https://andres-nova.github.io" onclick="gtag('event','footer_click',{event_category:'footer',event_label:'portafolio'})">Portafolio</a>
    </p>
  </footer>

  <script is:inline>
  (function () {
    const milestones = [25, 50, 75, 90];
    const fired = new Set();
    window.addEventListener('scroll', () => {
      const total = document.body.scrollHeight - window.innerHeight;
      if (total <= 0) return;
      const pct = Math.round((window.scrollY / total) * 100);
      milestones.forEach(m => {
        if (pct >= m && !fired.has(m)) {
          fired.add(m);
          gtag('event', 'scroll_depth', { event_category: 'blog', event_label: 'post_automatizacion', value: m });
        }
      });
    }, { passive: true });
  })();
  </script>
</BaseLayout>
